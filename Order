  <link rel="stylesheet" href="style.css">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
  <header class="site-header">
    <a class="logo" href="index.html">All Green Foundation</a>
    <nav aria-label="Main navigation">
      <ul class="nav-list">
        <li><a href="index.html">Home</a></li>
        <li><a href="about.html">About</a></li>
        <li><a href="garden.html">Our Garden</a></li>
        <li><a href="activities.html">Activities</a></li>
        <li><a href="gallery.html">Gallery</a></li>
        <li><a href="menu.html">Produce</a></li>
        <li><a href="promotions.html">Events</a></li>
        <li><a href="order.html" aria-current="page">Enquiry</a></li>
        <li><a href="contact.html">Contact</a></li>
        <li><a href="sitemap.html">Sitemap</a></li>
      </ul>
    </nav>
  </header>

  <main class="page-main">
    <section class="page-heading">
      <p class="eyebrow">Get in touch</p>
      <h1>Produce Enquiry</h1>
      <p>Send us an enquiry about garden produce or availability.</p>
    </section>

    <section class="content-section">
      <form class="enquiry-form" action="mailto:info@allgreenfoundation.org" method="post" enctype="text/plain">
        <label for="name">Your name</label>
        <input id="name" name="Name" type="text" autocomplete="name" required>

        <label for="email">Your email</label>
        <input id="email" name="Email" type="email" autocomplete="email" required>

        <label for="item">Enquiry topic</label>
        <select id="item" name="Topic" required>
          <option value="">Choose a topic</option>
          <option value="Vegetables">Seasonal vegetables</option>
          <option value="Herbs">Fresh herbs</option>
          <option value="Seedlings">Garden seedlings</option>
          <option value="Other">Other enquiry</option>
        </select>

        <label for="details">Message</label>
        <textarea id="details" name="Message" rows="5" required></textarea>

        <button class="button" type="submit">Prepare email enquiry</button>
      </form>

      <p class="form-note">
        This example opens your email application. It does not store or process
        orders online.
      </p>
    </section>
  </main>

  <footer class="site-footer">
    <p>&copy; 2026 All Green Foundation. All rights reserved.</p>
    <p><a href="sitemap.html">View sitemap</a></p>
  </footer>
</body>
